fn main() {
    let arr: [int] = array(5);

    fill(arr, 7, 5);

    let i: int = 0;
    while i < 5 {
        print(arr[i]);
        i = i + 1;
    }

    return;
}

fn fill(arr: [int], value: int, n: int) {
    let i: int = 0;

    while i < n {
        arr[i] = value;
        i = i + 1;
    }

    return;
}
