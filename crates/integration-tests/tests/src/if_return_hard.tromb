fn main() {
    print(foo(1, 1));
    print(foo(1, 0));
    print(foo(0, 1));
    print(foo(0, 0));
    return;
}

fn foo(x: int, y: int) -> int {
    if x {
        if y {
            return 3;
        } else {
            return 2;
        }
    } else {
        if y {
            return 1;
        } else {
            return 0;
        }
    }
    return -1;
}
