fn main() {
    let arr: [int] = array(5);

    arr[0] = 1;
    arr[1] = 2;
    arr[2] = 3;
    arr[3] = 4;
    arr[4] = 5;

    reverse(arr, 5);

    let i: int = 0;
    while i < 5 {
        print(arr[i]);
        i = i + 1;
    }

    return;
}

fn reverse(arr: [int], n: int) {
    let left: int = 0;
    let right: int = n - 1;

    while left < right {
        let temp: int = arr[left];
        arr[left] = arr[right];
        arr[right] = temp;

        left = left + 1;
        right = right - 1;
    }

    return;
}
