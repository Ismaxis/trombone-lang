fn main() {
    let arr: [int] = array(3);

    arr[0] = 11;
    arr[1] = 22;
    arr[2] = 33;

    print_forward(arr, 0, 3);

    return;
}

fn print_forward(arr: [int], index: int, n: int) {
    if index < n {
        print(arr[index]);
        print_forward(arr, index + 1, n);
    }

    return;
}
