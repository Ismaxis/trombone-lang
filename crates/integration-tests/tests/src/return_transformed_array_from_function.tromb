fn main() {
    let source: [int] = array(8);

    source[0] = 12;
    source[1] = 3;
    source[2] = 19;
    source[3] = 7;
    source[4] = 1;
    source[5] = 15;
    source[6] = 8;
    source[7] = 4;

    let transformed: [int] = transform_array(source, 8);

    let total: int = sum_array(transformed, 8);
    print(total);

    let i: int = 0;
    while i < 8 {
        print(transformed[i]);
        i = i + 1;
    }

    transformed[0] = 100;
    transformed[7] = 200;

    print(source[0]);
    print(source[7]);

    print(transformed[0]);
    print(transformed[7]);

    return;
}

fn transform_array(source: [int], n: int) -> [int] {
    let destination: [int] = array(n);
    let i: int = 0;

    while i < n {
        destination[i] = source[n - i - 1] * 2;
        i = i + 1;
    }

    return destination;
}

fn sum_array(arr: [int], n: int) -> int {
    let total: int = 0;
    let i: int = 0;

    while i < n {
        total = total + arr[i];
        i = i + 1;
    }

    return total;
}
