fn main() {
    print(while_in_if(1));
    print(while_in_if(2));
    print(if_in_while(1));
    print(if_in_while(2));
    return;
}

fn while_in_if(x: int) -> int {
    if x {
        while x == 1 {
            return 1;
        }
        return 0;
    }
    return -1;
}

fn if_in_while(x: int) -> int {
    while x {
        if x == 1 {
            return 1;
        }
        return 0;
    }
    return -1;
}
