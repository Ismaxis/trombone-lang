fn main() {
    let n: int = read();
    let i: int = 0;
    let arr: [int] = array(3);

    i = 0;
    while i < n {
        i = i + 1;
        let x0: int = 0;
        let y0: int = 1;
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        y0 = y0 * (x0 + 1);
        arr[0] = y0;

        let x1: int = 1;
        let y1: int = 1;
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        y1 = y1 * (x1 + 1);
        arr[1] = y1;

        let x2: int = 2;
        let y2: int = 1;
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        y2 = y2 * (x2 + 1);
        arr[2] = y2;
    }

    i = 0;
    while i < 3 {
        print(arr[i]);
        i = i + 1;
    }
}
