fn main() {
    let n: int = read();
    let arr: [int] = array(n);
    let i: int = 0;
    while i < n {
        arr[i] = read();
        i = i + 1;
    }

    let swapped: int = 1;
    while swapped {
        swapped = 0;
        let j: int = 1;
        while j < n {
            if arr[j - 1] > arr[j] {
                let temp: int = arr[j - 1];
                arr[j - 1] = arr[j];
                arr[j] = temp;
                swapped = 1;
            }
            j = j + 1;
        }
    }

    i = 0;
    while i < n {
        print(arr[i]);
        i = i + 1;
    }
    return;
}
