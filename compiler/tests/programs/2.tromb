fn main() {
    let i: int = 4;
    let j: int = 6;
    i = 5;
    i = j;
    while i > 1 {
        i = i - 1;
    }
    let n: int = read();
    let in: int = 0;
    let arr: [ int ] = array(n);
    i = n;
    while i > 0 {
        arr[n - i] = read();
        i = i - 1;
    }
    while in >= 0 {
        in = read();
        j = print(in);
        if 0 <= in {
            j = print(arr[in]);
        }
    }
}
