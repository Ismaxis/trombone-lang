fn main() {
    let i: int = 4;
    let j: int = 6;
    i = 5;
    i = j;
    while i > 1 {
        i = i - 1;
    }
    i = 2;
    let arr: [ int ] = array(2);
    while i > 0 {
        i = i - 1;
        arr[i] = read();
    }
    while i < 2 {
        j = print(arr[i]);
        i = i + 1;
    }

}