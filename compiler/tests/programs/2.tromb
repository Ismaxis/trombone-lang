fn main() {
    let i: int = 4;
    let j: int = 6;
    i = 5;
    i = j;
    while i > 1 {
        i = i - 1;
    }
    if (i == 1) {
        j = 4;
    } else {
        j = 3;
    }
    if (i > 1) {
        i = 3;
    } else {
        i = 2;
    }
    let k: int = 0;
    if (i == 3) {
        k = 1;
    } else if (i == 2) {
        k = 2;
    } else {
        k = 3;
    }

}