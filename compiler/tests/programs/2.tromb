fn main() {
    let n: int = read();
    let tmp: int = 0;
    
    let is_prime: [int] = array(n + 1);
    
    while tmp <= n {
        is_prime[tmp] = 1;
        tmp = tmp + 1;
    }
    is_prime[0] = 0;
    is_prime[1] = 0;

    let i: int = 2;
    let j: int = 0;
    while i * i <= n {
        if is_prime[i] {
            j = i * i;
            while j <= n {
                is_prime[j] = 0;
                j = j + i;
            }
        }
        i = i + 1;
    }

    i = 0;
    while i <= n {
        if is_prime[i] {
            j = print(i);
        }
        i = i + 1;
    }
}
